{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hraedon/socratic-specification/schemas/change-spec-v1.schema.json",
  "title": "Socratic Existing-System Change Specification v1",
  "type": "object",
  "required": ["change_schema_version", "change_revision", "meta", "baseline", "change", "preserved_behaviors", "touched_couplings", "changed_contracts", "compatibility", "acceptance_criteria", "risks", "handoff"],
  "properties": {
    "change_schema_version": {"const": 1},
    "change_revision": {"type": "integer", "minimum": 1},
    "meta": {
      "type": "object",
      "required": ["change_id", "title", "date", "source_spec_id", "source_spec_fingerprint", "parent_change_fingerprint"],
      "properties": {
        "change_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "title": {"type": "string", "minLength": 1},
        "date": {"type": "string", "format": "date"},
        "source_spec_id": {"type": "string"},
        "source_spec_fingerprint": {"type": "string"},
        "parent_change_fingerprint": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "baseline": {
      "type": "object",
      "required": ["repository", "commit", "release_or_state", "current_behavior", "quality_gates"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "commit": {"type": "string"},
        "release_or_state": {"type": "string"},
        "current_behavior": {"type": "string", "minLength": 1},
        "quality_gates": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": false
    },
    "change": {
      "type": "object",
      "required": ["statement", "user_outcome", "in_scope", "out_of_scope", "provenance"],
      "properties": {
        "statement": {"type": "string", "minLength": 1},
        "user_outcome": {"type": "string", "minLength": 1},
        "in_scope": {"type": "array", "items": {"type": "string"}},
        "out_of_scope": {"type": "array", "items": {"type": "string"}},
        "provenance": {"$ref": "#/$defs/provenance"}
      },
      "additionalProperties": false
    },
    "preserved_behaviors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "behavior", "evidence", "regression_acceptance_ids"],
        "properties": {
          "id": {"type": "string", "pattern": "^PRESERVE-[0-9]+$"},
          "behavior": {"type": "string", "minLength": 1},
          "evidence": {"type": "string", "minLength": 1},
          "regression_acceptance_ids": {"type": "array", "items": {"$ref": "#/$defs/acId"}, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    },
    "touched_couplings": {"type": "array", "items": {"type": "object"}},
    "changed_contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "change", "preserved_invariant", "consumers"],
        "properties": {
          "id": {"type": "string", "pattern": "^CHANGE-CONTRACT-[0-9]+$"},
          "name": {"type": "string", "minLength": 1},
          "change": {"type": "string", "minLength": 1},
          "preserved_invariant": {"type": "string"},
          "consumers": {"type": "array", "items": {"type": "object"}}
        },
        "additionalProperties": false
      }
    },
    "compatibility": {
      "type": "object",
      "required": ["classification", "supported_read_versions", "emitted_write_version", "migration", "rollback", "deprecation_or_communication", "historical_fixtures"],
      "properties": {
        "classification": {"enum": ["non_breaking", "breaking"]},
        "supported_read_versions": {"type": "array", "items": {"type": ["string", "integer"]}},
        "emitted_write_version": {"type": ["string", "integer"]},
        "migration": {"type": "string"},
        "rollback": {"type": "string"},
        "deprecation_or_communication": {"type": "string"},
        "historical_fixtures": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "condition", "changed_contract_ids", "preserved_behavior_ids", "provenance"],
        "properties": {
          "id": {"$ref": "#/$defs/acId"},
          "kind": {"enum": ["change", "regression", "migration", "rollback"]},
          "condition": {"type": "string", "minLength": 1},
          "changed_contract_ids": {"type": "array", "items": {"type": "string"}},
          "preserved_behavior_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "provenance": {"$ref": "#/$defs/provenance"}
        },
        "additionalProperties": false
      }
    },
    "risks": {"type": "array", "items": {"type": "object"}},
    "handoff": {"type": "object"}
  },
  "additionalProperties": false,
  "$defs": {
    "acId": {"type": "string", "pattern": "^CAC-[0-9]+$"},
    "provenance": {
      "type": "object",
      "required": ["kind", "note"],
      "properties": {
        "kind": {"enum": ["human_stated", "translated_confirmed", "repo_observed", "agent_inferred", "assumed", "externally_verified"]},
        "note": {"type": "string"}
      },
      "additionalProperties": false
    }
  }
}
